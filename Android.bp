android_app_import {
    name: "JamesDSP",
    owner: "james34602",
    apk: "proprietary/product/app/JamesDSP/JamesDSP.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: ["AudioFX", "MusicFX"],
    product_specific: true,
}

cc_prebuilt_library_static {
    name: "libjamesdsp_engine",
    target: {
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/soundfx/libjamesdsp_engine_static.a"],
        },
    },
    vendor: true,
}

cc_library_shared {
    name: "libjamesdspaidl",
    defaults: ["aidlaudioeffectservice_defaults"],
    srcs: [
        "aidl-wrapper/JamesDspAidlEffect.cpp",
        ":effectCommonFile",
    ],
    whole_static_libs: [
        "libjamesdsp_engine",
    ],
    shared_libs: [
        "liblog",
    ],
    header_libs: [
        "libjamesdsp_engine_headers",
    ],
    relative_install_path: "soundfx",
    vendor: true,
    ignore_max_page_size: true,
}

cc_library_headers {
    name: "libjamesdsp_engine_headers",
    export_include_dirs: ["proprietary/include", "proprietary/include/jdsp"],
    vendor: true,
}
